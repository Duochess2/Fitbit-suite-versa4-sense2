{
  "name": "fitbit-all-in-one-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Unified 3-in-1 application suite for Fitbit Versa 4",
  "main": "app/index.js",
  "fitbit": {
    "appUUID": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "appType": "app",
    "appDisplayName": "App Suite",
    "iconFile": "resources/icon.png",
    "wipeColor": "#000000",
    "requestedPermissions": [
      "access_internet",
      "access_location",
      "access_activity",
      "access_heart_rate",
      "access_accelerometer"
    ],
    "buildTargets": [
      "hera",
      "rhea"
    ],
    "i18n": {},
    "defaultLanguage": "en-US",
    "enableProposedAPI": true
  },
  "scripts": {
    "build": "fitbit-build",
    "debug": "fitbit"
  },
  "devDependencies": {
    "@fitbit/sdk": "~7.1.0-pre.0",
    "@fitbit/sdk-build-targets": "cmengler/fitbit-sdk-build-targets",
    "@fitbit/sdk-cli": "~1.8.0-pre.10",
    "fitbit-sdk-types": "^8.0.3"
  }
}
